<?xml version="1.0" encoding="utf-8"?>
<!-- The notification small icon is referenced only by string name from Dart
     (flutter_local_notifications), so the release resource shrinker cannot see
     it is used and would strip it, making notifications fail to post. Keep it. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notify" />
